# Source of truth for the docs-site container image tag, consumed by the org
# version-links fan-out (zeroroot-ai/.github version-links.yaml, link `docs-site`)
# to re-pin charts' docs.image on every release. release-please rewrites only the
# semver on the annotated line below (the `v` prefix and key are preserved), so
# this stays in lockstep with the published image tag `ghcr.io/zeroroot-ai/docs-site:v<semver>`.
DOCS_SITE_IMAGE_TAG=v0.6.12 # x-release-please-version
