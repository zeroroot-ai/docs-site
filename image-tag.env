# Source of truth for the docs-site container image tag, consumed by the org
# version-links fan-out (zeroroot-ai/.github version-links.yaml, link `docs-site`)
# to re-pin charts' docs.image on every release.
#
# The release-please annotation is on its OWN lines (block form), NOT inline on
# the value line: version-fanout.py's env reader takes everything after `=` as
# the value, so an inline `# x-release-please-version` comment would be parsed
# into the value and rejected as unsafe. Block markers keep the value line clean
# while release-please still bumps the semver (the `v` prefix is preserved).
# x-release-please-start-version
DOCS_SITE_IMAGE_TAG=v0.6.15
# x-release-please-end
